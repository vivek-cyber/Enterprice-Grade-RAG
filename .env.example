# Qdrant Cloud cluster URL (https://cloud.qdrant.io) and API key used by QdrantVectorStore.
QDRANT_URL=
QDRANT_API_KEY=

# Logfire write token (run `logfire auth` then `logfire projects new`). If unset,
# ingestion runs locally without sending traces to the Logfire dashboard.
LOGFIRE_TOKEN=

# Optional overrides for the local Nomic embedding provider (--embeddings local).
# NOMIC_EMBED_DEVICE: torch device, e.g. cpu or cuda. Unset lets torch choose.
# NOMIC_EMBED_CACHE_DIR: where model weights are cached. Unset uses the default
# HuggingFace cache (~/.cache/huggingface).
NOMIC_EMBED_DEVICE=
NOMIC_EMBED_CACHE_DIR=

# Docling runs its layout/table models on CPU by default; CUDA exhausted VRAM
# on large PDFs. Set to "cuda" only if you have headroom.
DOCLING_ACCELERATOR_DEVICE=cpu
